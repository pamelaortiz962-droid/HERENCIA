class Vehiculo:
    def __init__(self, marca, modelo, anio):
        self.marca = marca
        self.modelo = modelo
        self.anio = anio

    def mostrar_detalles(self):
        print(f"Marca: {self.marca}")
        print(f"Modelo: {self.modelo}")
        print(f"Año: {self.anio}")


class Automovil(Vehiculo):
    def __init__(self, marca, modelo, anio, km_por_litro):
        super().__init__(marca, modelo, anio)
        self.km_por_litro = km_por_litro

    def calcular_eficiencia(self):
        return self.km_por_litro

    def combustible_necesario(self, distancia):
        return distancia / self.km_por_litro

    def mostrar_detalles(self):
        super().mostrar_detalles()
        print(f"Eficiencia: {self.calcular_eficiencia()} km/l")
        print(f"Combustible para 200 km: {self.combustible_necesario(200):.2f} litros")


class Motocicleta(Vehiculo):
    def __init__(self, marca, modelo, anio, km_por_litro):
        super().__init__(marca, modelo, anio)
        self.km_por_litro = km_por_litro

    def calcular_eficiencia(self):
        return self.km_por_litro

    def combustible_necesario(self, distancia):
        return distancia / self.km_por_litro

    def mostrar_detalles(self):
        super().mostrar_detalles()
        print(f"Eficiencia: {self.calcular_eficiencia()} km/l")
        print(f"Combustible para 200 km: {self.combustible_necesario(200):.2f} litros")


# Ejemplo de uso
if __name__ == "__main__":
    a = Automovil("Audi", "A4", 2022, 15)
    a.mostrar_detalles()

    print()

    m = Motocicleta("BMW", "R 1250 GS", 2023, 25)
    m.mostrar_detalles()
